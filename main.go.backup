package main

import (
	"crypto/rand"
	"encoding/base64"
	"log"
	"os"
	"strconv"
	"strings"
	"time"

	"github.com/gofiber/fiber/v2"
	"github.com/gofiber/fiber/v2/middleware/cors"
	"github.com/gofiber/fiber/v2/middleware/logger"
	"golang.org/x/crypto/bcrypt"
	"gorm.io/driver/postgres"
	"gorm.io/gorm"
)

// ============================================================================
// MODELS
// ============================================================================

// Product model with enhanced fields
type Product struct {
	ProductID         uint      `gorm:"primaryKey" json:"product_id"`
	SKU               string    `gorm:"unique;not null" json:"sku"`
	Name              string    `gorm:"not null;index" json:"name"`
	Description       string    `json:"description"`
	Category          string    `gorm:"not null" json:"category"`
	Quantity          int       `gorm:"not null" json:"quantity"`
	LowStockThreshold int       `gorm:"default:10" json:"low_stock_threshold"`
	Price             float64   `json:"price"`
	Version           int       `gorm:"default:1" json:"version"` // For optimistic locking
	CreatedAt         time.Time `json:"created_at"`
	UpdatedAt         time.Time `json:"updated_at"`
	CreatedBy         uint      `json:"created_by"`
	UpdatedBy         uint      `json:"updated_by"`
}

// User model with password hashing
type User struct {
	UserID       uint       `gorm:"primaryKey" json:"user_id"`
	Username     string     `gorm:"unique;not null;index" json:"username"`
	Email        string     `gorm:"unique;not null" json:"email"`
	Role         string     `gorm:"not null" json:"role"` // Administrator, Warehouse Manager, Warehouse Employee, Sales Associate
	PasswordHash string     `json:"-"`
	IsActive     bool       `gorm:"default:true" json:"is_active"`
	FailedLogins int        `gorm:"default:0" json:"-"`
	LockedUntil  *time.Time `json:"-"`
	CreatedAt    time.Time  `json:"created_at"`
	UpdatedAt    time.Time  `json:"updated_at"`
}

// Session model for authentication
type Session struct {
	SessionID string    `gorm:"primaryKey" json:"session_id"`
	UserID    uint      `gorm:"not null;index" json:"user_id"`
	ExpiresAt time.Time `gorm:"not null;index" json:"expires_at"`
	CreatedAt time.Time `json:"created_at"`
	IPAddress string    `json:"ip_address"`
	UserAgent string    `json:"user_agent"`
}

// AuditLog model for tracking all changes (FR-005)
type AuditLog struct {
	LogID      uint      `gorm:"primaryKey" json:"log_id"`
	UserID     uint      `gorm:"index" json:"user_id"`
	Username   string    `json:"username"`
	Action     string    `gorm:"not null;index" json:"action"` // CREATE, UPDATE, DELETE, LOGIN, LOGOUT
	EntityType string    `json:"entity_type"`                  // Product, User, Session
	EntityID   uint      `json:"entity_id"`
	OldValue   string    `json:"old_value"`
	NewValue   string    `json:"new_value"`
	IPAddress  string    `json:"ip_address"`
	Timestamp  time.Time `gorm:"not null;index" json:"timestamp"`
	Success    bool      `gorm:"default:true" json:"success"`
	ErrorMsg   string    `json:"error_msg"`
}

// LowStockAlert model (FR-004)
type LowStockAlert struct {
	AlertID        uint       `gorm:"primaryKey" json:"alert_id"`
	ProductID      uint       `gorm:"index" json:"product_id"`
	ProductName    string     `json:"product_name"`
	CurrentQty     int        `json:"current_qty"`
	Threshold      int        `json:"threshold"`
	Severity       string     `json:"severity"` // CRITICAL, WARNING
	CreatedAt      time.Time  `json:"created_at"`
	Acknowledged   bool       `gorm:"default:false" json:"acknowledged"`
	AcknowledgedBy uint       `json:"acknowledged_by"`
	AcknowledgedAt *time.Time `json:"acknowledged_at"`
}

var DB *gorm.DB

// ============================================================================
// CONFIGURATION
// ============================================================================

const (
	SessionDuration      = 8 * time.Hour
	MaxFailedLogins      = 5
	AccountLockDuration  = 15 * time.Minute
	MaxNameLength        = 200
	MaxDescriptionLength = 500
	MaxQuantity          = 1000000
	BcryptCost           = 12
)

// Role constants
const (
	RoleAdmin     = "Administrator"
	RoleManager   = "Warehouse Manager"
	RoleEmployee  = "Warehouse Employee"
	RoleAssociate = "Sales Associate"
)

// ============================================================================
// DATABASE INITIALIZATION
// ============================================================================

func InitDatabase() error {
	// Get DSN from environment or use default
	dsn := os.Getenv("DATABASE_URL")
	if dsn == "" {
		dsn = "host=localhost user=postgres password=postgres dbname=dundermifflin port=5432 sslmode=disable"
	}

	var err error
	DB, err = gorm.Open(postgres.Open(dsn), &gorm.Config{
		// Add connection pool settings for performance (NFR-002)
		PrepareStmt: true,
	})
	if err != nil {
		return err
	}

	// Configure connection pool
	sqlDB, err := DB.DB()
	if err != nil {
		return err
	}
	sqlDB.SetMaxIdleConns(10)
	sqlDB.SetMaxOpenConns(100)
	sqlDB.SetConnMaxLifetime(time.Hour)

	// Auto-migrate models
	err = DB.AutoMigrate(&Product{}, &User{}, &Session{}, &AuditLog{}, &LowStockAlert{})
	if err != nil {
		return err
	}

	// Create indexes for performance
	DB.Exec("CREATE INDEX IF NOT EXISTS idx_products_quantity ON products(quantity)")
	DB.Exec("CREATE INDEX IF NOT EXISTS idx_audit_logs_timestamp ON audit_logs(timestamp DESC)")
	DB.Exec("CREATE INDEX IF NOT EXISTS idx_sessions_expires_at ON sessions(expires_at)")

	log.Println("✓ Database connected and migrated successfully (PostgreSQL)")
	return nil
}

// Seed initial users with hashed passwords
func SeedUsers() error {
	users := []struct {
		Username string
		Email    string
		Role     string
		Password string
	}{
		{Username: "admin", Email: "admin@dundermifflin.com", Role: RoleAdmin, Password: "Admin123!"},
		{Username: "mscott", Email: "michael@dundermifflin.com", Role: RoleManager, Password: "Manager123!"},
		{Username: "dwight", Email: "dwight@dundermifflin.com", Role: RoleEmployee, Password: "Employee123!"},
		{Username: "jim", Email: "jim@dundermifflin.com", Role: RoleAssociate, Password: "Sales123!"},
	}

	for _, u := range users {
		var existing User
		result := DB.Where("username = ?", u.Username).First(&existing)
		if result.RowsAffected == 0 {
			hashedPassword, err := bcrypt.GenerateFromPassword([]byte(u.Password), BcryptCost)
			if err != nil {
				return err
			}
			user := User{
				Username:     u.Username,
				Email:        u.Email,
				Role:         u.Role,
				PasswordHash: string(hashedPassword),
				IsActive:     true,
			}
			if err := DB.Create(&user).Error; err != nil {
				return err
			}
			log.Printf("✓ Created user: %s (password: %s)", u.Username, u.Password)
		}
	}
	return nil
}

// ============================================================================
// AUTHENTICATION & AUTHORIZATION MIDDLEWARE
// ============================================================================

// Generate secure session ID
func generateSessionID() (string, error) {
	b := make([]byte, 32)
	if _, err := rand.Read(b); err != nil {
		return "", err
	}
	return base64.URLEncoding.EncodeToString(b), nil
}

// AuthMiddleware validates session and adds user context
func AuthMiddleware(c *fiber.Ctx) error {
	sessionID := c.Cookies("session_id")
	if sessionID == "" {
		// Check Authorization header as fallback
		authHeader := c.Get("Authorization")
		if strings.HasPrefix(authHeader, "Bearer ") {
			sessionID = strings.TrimPrefix(authHeader, "Bearer ")
		}
	}

	if sessionID == "" {
		return c.Status(401).JSON(fiber.Map{
			"error": "Authentication required",
			"code":  "UNAUTHORIZED",
		})
	}

	var session Session
	if err := DB.Where("session_id = ? AND expires_at > ?", sessionID, time.Now()).First(&session).Error; err != nil {
		return c.Status(401).JSON(fiber.Map{
			"error": "Invalid or expired session",
			"code":  "SESSION_EXPIRED",
		})
	}

	var user User
	if err := DB.First(&user, session.UserID).Error; err != nil {
		return c.Status(401).JSON(fiber.Map{
			"error": "User not found",
			"code":  "USER_NOT_FOUND",
		})
	}

	if !user.IsActive {
		return c.Status(403).JSON(fiber.Map{
			"error": "Account is disabled",
			"code":  "ACCOUNT_DISABLED",
		})
	}

	// Add user to context
	c.Locals("user", user)
	c.Locals("session", session)
	return c.Next()
}

// RoleMiddleware checks if user has required role
func RoleMiddleware(allowedRoles ...string) fiber.Handler {
	return func(c *fiber.Ctx) error {
		user, ok := c.Locals("user").(User)
		if !ok {
			return c.Status(401).JSON(fiber.Map{
				"error": "Authentication required",
				"code":  "UNAUTHORIZED",
			})
		}

		for _, role := range allowedRoles {
			if user.Role == role {
				return c.Next()
			}
		}

		LogAudit(user.UserID, user.Username, "ACCESS_DENIED", "Route", 0, "", "", c.IP(), false, "Insufficient permissions")

		return c.Status(403).JSON(fiber.Map{
			"error":          "You do not have permission to perform this action",
			"code":           "FORBIDDEN",
			"required_roles": allowedRoles,
		})
	}
}

// ============================================================================
// AUDIT LOGGING (FR-005)
// ============================================================================

func LogAudit(userID uint, username, action, entityType string, entityID uint, oldValue, newValue, ipAddress string, success bool, errorMsg string) {
	audit := AuditLog{
		UserID:     userID,
		Username:   username,
		Action:     action,
		EntityType: entityType,
		EntityID:   entityID,
		OldValue:   oldValue,
		NewValue:   newValue,
		IPAddress:  ipAddress,
		Timestamp:  time.Now(),
		Success:    success,
		ErrorMsg:   errorMsg,
	}
	DB.Create(&audit)
}

// ============================================================================
// VALIDATION FUNCTIONS (NFR-001)
// ============================================================================

type ValidationError struct {
	Field   string `json:"field"`
	Message string `json:"message"`
}

func ValidateProduct(product *Product) []ValidationError {
	var errors []ValidationError

	// Required fields
	if strings.TrimSpace(product.Name) == "" {
		errors = append(errors, ValidationError{Field: "name", Message: "Product name is required"})
	}
	if len(product.Name) > MaxNameLength {
		errors = append(errors, ValidationError{Field: "name", Message: "Name must be 200 characters or less"})
	}
	if len(product.Description) > MaxDescriptionLength {
		errors = append(errors, ValidationError{Field: "description", Message: "Description must be 500 characters or less"})
	}
	if strings.TrimSpace(product.SKU) == "" {
		errors = append(errors, ValidationError{Field: "sku", Message: "SKU is required"})
	}
	if strings.TrimSpace(product.Category) == "" {
		errors = append(errors, ValidationError{Field: "category", Message: "Category is required"})
	}
	if product.Quantity < 0 {
		errors = append(errors, ValidationError{Field: "quantity", Message: "Quantity cannot be negative"})
	}
	if product.Quantity > MaxQuantity {
		errors = append(errors, ValidationError{Field: "quantity", Message: "Quantity exceeds maximum allowed"})
	}
	if product.LowStockThreshold < 0 {
		errors = append(errors, ValidationError{Field: "low_stock_threshold", Message: "Threshold cannot be negative"})
	}

	return errors
}

// ============================================================================
// AUTHENTICATION ROUTES (NFR-003)
// ============================================================================

type LoginRequest struct {
	Username string `json:"username"`
	Password string `json:"password"`
}

type LoginResponse struct {
	SessionID string    `json:"session_id"`
	User      User      `json:"user"`
	ExpiresAt time.Time `json:"expires_at"`
}

func Login(c *fiber.Ctx) error {
	var req LoginRequest
	if err := c.BodyParser(&req); err != nil {
		return c.Status(400).JSON(fiber.Map{
			"error": "Invalid request body",
			"code":  "INVALID_REQUEST",
		})
	}

	// Validate input
	if strings.TrimSpace(req.Username) == "" || strings.TrimSpace(req.Password) == "" {
		return c.Status(400).JSON(fiber.Map{
			"error": "Username and password are required",
			"code":  "MISSING_CREDENTIALS",
		})
	}

	// Find user
	var user User
	if err := DB.Where("username = ?", req.Username).First(&user).Error; err != nil {
		LogAudit(0, req.Username, "LOGIN_FAILED", "User", 0, "", "", c.IP(), false, "User not found")
		return c.Status(401).JSON(fiber.Map{
			"error": "Invalid username or password",
			"code":  "INVALID_CREDENTIALS",
		})
	}

	// Check if account is locked
	if user.LockedUntil != nil && user.LockedUntil.After(time.Now()) {
		return c.Status(403).JSON(fiber.Map{
			"error":        "Account temporarily locked due to multiple failed attempts",
			"code":         "ACCOUNT_LOCKED",
			"locked_until": user.LockedUntil,
		})
	}

	// Check if account is active
	if !user.IsActive {
		return c.Status(403).JSON(fiber.Map{
			"error": "Account is disabled",
			"code":  "ACCOUNT_DISABLED",
		})
	}

	// Verify password
	if err := bcrypt.CompareHashAndPassword([]byte(user.PasswordHash), []byte(req.Password)); err != nil {
		// Increment failed login counter
		user.FailedLogins++
		if user.FailedLogins >= MaxFailedLogins {
			lockUntil := time.Now().Add(AccountLockDuration)
			user.LockedUntil = &lockUntil
			DB.Save(&user)
			LogAudit(user.UserID, user.Username, "ACCOUNT_LOCKED", "User", user.UserID, "", "", c.IP(), false, "Too many failed attempts")
			return c.Status(403).JSON(fiber.Map{
				"error":        "Account locked due to too many failed attempts",
				"code":         "ACCOUNT_LOCKED",
				"locked_until": lockUntil,
			})
		}
		DB.Save(&user)
		LogAudit(user.UserID, user.Username, "LOGIN_FAILED", "User", user.UserID, "", "", c.IP(), false, "Invalid password")
		return c.Status(401).JSON(fiber.Map{
			"error": "Invalid username or password",
			"code":  "INVALID_CREDENTIALS",
		})
	}

	// Reset failed login counter on successful login
	user.FailedLogins = 0
	user.LockedUntil = nil
	DB.Save(&user)

	// Create session
	sessionID, err := generateSessionID()
	if err != nil {
		LogAudit(user.UserID, user.Username, "LOGIN_FAILED", "Session", 0, "", "", c.IP(), false, "Failed to generate session")
		return c.Status(500).JSON(fiber.Map{
			"error": "Failed to create session",
			"code":  "SESSION_ERROR",
		})
	}

	expiresAt := time.Now().Add(SessionDuration)
	session := Session{
		SessionID: sessionID,
		UserID:    user.UserID,
		ExpiresAt: expiresAt,
		IPAddress: c.IP(),
		UserAgent: c.Get("User-Agent"),
	}

	if err := DB.Create(&session).Error; err != nil {
		LogAudit(user.UserID, user.Username, "LOGIN_FAILED", "Session", 0, "", "", c.IP(), false, "Failed to create session")
		return c.Status(500).JSON(fiber.Map{
			"error": "Failed to create session",
			"code":  "SESSION_ERROR",
		})
	}

	LogAudit(user.UserID, user.Username, "LOGIN", "User", user.UserID, "", "", c.IP(), true, "")

	// Set cookie
	c.Cookie(&fiber.Cookie{
		Name:     "session_id",
		Value:    sessionID,
		Expires:  expiresAt,
		HTTPOnly: true,
		Secure:   false, // Set to true in production with HTTPS
		SameSite: "Lax",
	})

	return c.JSON(LoginResponse{
		SessionID: sessionID,
		User:      user,
		ExpiresAt: expiresAt,
	})
}

func Logout(c *fiber.Ctx) error {
	user := c.Locals("user").(User)
	session := c.Locals("session").(Session)

	// Delete session
	DB.Delete(&session)

	LogAudit(user.UserID, user.Username, "LOGOUT", "User", user.UserID, "", "", c.IP(), true, "")

	// Clear cookie
	c.Cookie(&fiber.Cookie{
		Name:     "session_id",
		Value:    "",
		Expires:  time.Now().Add(-time.Hour),
		HTTPOnly: true,
	})

	return c.JSON(fiber.Map{
		"message": "Logged out successfully",
	})
}

func GetCurrentUser(c *fiber.Ctx) error {
	user := c.Locals("user").(User)
	return c.JSON(user)
}

// ============================================================================
// PRODUCT ROUTES
// ============================================================================

// AddProduct handles adding a new product (FR-001) with comprehensive validation and error handling
func AddProduct(c *fiber.Ctx) error {
	user := c.Locals("user").(User)
	var product Product

	if err := c.BodyParser(&product); err != nil {
		return c.Status(400).JSON(fiber.Map{
			"error": "Invalid request body",
			"code":  "INVALID_REQUEST",
		})
	}

	// Validate product
	if validationErrors := ValidateProduct(&product); len(validationErrors) > 0 {
		return c.Status(400).JSON(fiber.Map{
			"error":   "Validation failed",
			"code":    "VALIDATION_ERROR",
			"details": validationErrors,
		})
	}

	// Check for duplicate SKU
	var existing Product
	result := DB.Where("sku = ?", product.SKU).First(&existing)
	if result.RowsAffected > 0 {
		return c.Status(409).JSON(fiber.Map{
			"error":            "Product with this SKU already exists",
			"code":             "DUPLICATE_SKU",
			"existing_product": existing,
		})
	}

	// Check for duplicate name
	result = DB.Where("name = ?", product.Name).First(&existing)
	if result.RowsAffected > 0 {
		return c.Status(409).JSON(fiber.Map{
			"error":            "Product with this name already exists",
			"code":             "DUPLICATE_NAME",
			"suggestion":       "Consider updating the existing product",
			"existing_product": existing,
		})
	}

	// Set audit fields
	product.CreatedBy = user.UserID
	product.UpdatedBy = user.UserID
	product.CreatedAt = time.Now()
	product.UpdatedAt = time.Now()
	product.Version = 1

	// Create product
	if err := DB.Create(&product).Error; err != nil {
		LogAudit(user.UserID, user.Username, "CREATE_PRODUCT", "Product", 0, "", "", c.IP(), false, err.Error())
		return c.Status(500).JSON(fiber.Map{
			"error": "Failed to create product",
			"code":  "DATABASE_ERROR",
		})
	}

	LogAudit(user.UserID, user.Username, "CREATE_PRODUCT", "Product", product.ProductID, "", product.Name, c.IP(), true, "")

	// Check if product is below low stock threshold
	if product.Quantity <= product.LowStockThreshold {
		CreateLowStockAlert(product)
	}

	return c.Status(201).JSON(fiber.Map{
		"message": "Product created successfully",
		"product": product,
	})
}

// GetInventory retrieves all products (FR-002) with search/filter
func GetInventory(c *fiber.Ctx) error {
	var products []Product

	// Get query parameters
	search := c.Query("search", "")
	category := c.Query("category", "")
	lowStock := c.Query("low_stock", "")

	query := DB

	// Apply filters
	if search != "" {
		query = query.Where("name ILIKE ? OR sku ILIKE ?", "%"+search+"%", "%"+search+"%")
	}
	if category != "" {
		query = query.Where("category = ?", category)
	}
	if lowStock == "true" {
		query = query.Where("quantity <= low_stock_threshold")
	}

	if err := query.Order("name ASC").Find(&products).Error; err != nil {
		return c.Status(500).JSON(fiber.Map{
			"error": "Unable to load inventory",
			"code":  "DATABASE_ERROR",
		})
	}

	return c.JSON(fiber.Map{
		"products": products,
		"count":    len(products),
	})
}

// GetProduct retrieves a single product by ID
func GetProduct(c *fiber.Ctx) error {
	id := c.Params("id")
	var product Product

	if err := DB.First(&product, id).Error; err != nil {
		return c.Status(404).JSON(fiber.Map{
			"error": "Product not found",
			"code":  "NOT_FOUND",
		})
	}

	return c.JSON(product)
}

// UpdateProduct updates product quantity (FR-003) with optimistic locking
func UpdateProduct(c *fiber.Ctx) error {
	user := c.Locals("user").(User)
	id := c.Params("id")

	var product Product
	if err := DB.First(&product, id).Error; err != nil {
		return c.Status(404).JSON(fiber.Map{
			"error": "Product not found",
			"code":  "NOT_FOUND",
		})
	}

	var updateData struct {
		Quantity int `json:"quantity"`
		Version  int `json:"version"`
	}

	if err := c.BodyParser(&updateData); err != nil {
		return c.Status(400).JSON(fiber.Map{
			"error": "Invalid request body",
			"code":  "INVALID_REQUEST",
		})
	}

	// Validate quantity
	if updateData.Quantity < 0 {
		return c.Status(400).JSON(fiber.Map{
			"error": "Quantity cannot be negative",
			"code":  "INVALID_QUANTITY",
		})
	}
	if updateData.Quantity > MaxQuantity {
		return c.Status(400).JSON(fiber.Map{
			"error":        "Quantity exceeds maximum allowed",
			"code":         "INVALID_QUANTITY",
			"max_quantity": MaxQuantity,
		})
	}

	// Optimistic locking: Check version
	if updateData.Version > 0 && updateData.Version != product.Version {
		return c.Status(409).JSON(fiber.Map{
			"error":           "This product was modified by another user. Please review the current data.",
			"code":            "CONCURRENT_MODIFICATION",
			"current_product": product,
		})
	}

	oldQuantity := strconv.Itoa(product.Quantity)
	newQuantity := strconv.Itoa(updateData.Quantity)

	// Update product
	product.Quantity = updateData.Quantity
	product.UpdatedAt = time.Now()
	product.UpdatedBy = user.UserID
	product.Version++

	if err := DB.Save(&product).Error; err != nil {
		LogAudit(user.UserID, user.Username, "UPDATE_PRODUCT", "Product", product.ProductID, oldQuantity, newQuantity, c.IP(), false, err.Error())
		return c.Status(500).JSON(fiber.Map{
			"error": "Failed to update product",
			"code":  "DATABASE_ERROR",
		})
	}

	LogAudit(user.UserID, user.Username, "UPDATE_PRODUCT", "Product", product.ProductID, oldQuantity, newQuantity, c.IP(), true, "")

	// Check for low stock and create alert if needed
	if product.Quantity <= product.LowStockThreshold {
		CreateLowStockAlert(product)
	}

	return c.JSON(fiber.Map{
		"message": "Product updated successfully",
		"product": product,
	})
}

// DeleteProduct removes a product
func DeleteProduct(c *fiber.Ctx) error {
	user := c.Locals("user").(User)
	id := c.Params("id")

	var product Product
	if err := DB.First(&product, id).Error; err != nil {
		return c.Status(404).JSON(fiber.Map{
			"error": "Product not found",
			"code":  "NOT_FOUND",
		})
	}

	if err := DB.Delete(&product).Error; err != nil {
		LogAudit(user.UserID, user.Username, "DELETE_PRODUCT", "Product", product.ProductID, product.Name, "", c.IP(), false, err.Error())
		return c.Status(500).JSON(fiber.Map{
			"error": "Failed to delete product",
			"code":  "DATABASE_ERROR",
		})
	}

	LogAudit(user.UserID, user.Username, "DELETE_PRODUCT", "Product", product.ProductID, product.Name, "", c.IP(), true, "")

	return c.JSON(fiber.Map{
		"message": "Product deleted successfully",
	})
}

// ============================================================================
// LOW STOCK ALERT ROUTES (FR-004)
// ============================================================================

func CreateLowStockAlert(product Product) {
	// Check if alert already exists
	var existingAlert LowStockAlert
	result := DB.Where("product_id = ? AND acknowledged = false", product.ProductID).First(&existingAlert)
	if result.RowsAffected > 0 {
		// Alert already exists
		return
	}

	severity := "WARNING"
	if product.Quantity == 0 {
		severity = "CRITICAL"
	}

	alert := LowStockAlert{
		ProductID:   product.ProductID,
		ProductName: product.Name,
		CurrentQty:  product.Quantity,
		Threshold:   product.LowStockThreshold,
		Severity:    severity,
		CreatedAt:   time.Now(),
	}

	DB.Create(&alert)
	log.Printf("⚠️  Low stock alert created for product: %s (Qty: %d, Threshold: %d)", product.Name, product.Quantity, product.LowStockThreshold)
}

func GetLowStockAlerts(c *fiber.Ctx) error {
	var alerts []LowStockAlert

	acknowledged := c.Query("acknowledged", "false")

	query := DB
	if acknowledged == "false" {
		query = query.Where("acknowledged = false")
	}

	if err := query.Order("severity DESC, current_qty ASC, created_at DESC").Find(&alerts).Error; err != nil {
		return c.Status(500).JSON(fiber.Map{
			"error": "Failed to retrieve alerts",
			"code":  "DATABASE_ERROR",
		})
	}

	return c.JSON(fiber.Map{
		"alerts": alerts,
		"count":  len(alerts),
	})
}

func AcknowledgeAlert(c *fiber.Ctx) error {
	user := c.Locals("user").(User)
	id := c.Params("id")

	var alert LowStockAlert
	if err := DB.First(&alert, id).Error; err != nil {
		return c.Status(404).JSON(fiber.Map{
			"error": "Alert not found",
			"code":  "NOT_FOUND",
		})
	}

	now := time.Now()
	alert.Acknowledged = true
	alert.AcknowledgedBy = user.UserID
	alert.AcknowledgedAt = &now

	if err := DB.Save(&alert).Error; err != nil {
		return c.Status(500).JSON(fiber.Map{
			"error": "Failed to acknowledge alert",
			"code":  "DATABASE_ERROR",
		})
	}

	return c.JSON(fiber.Map{
		"message": "Alert acknowledged successfully",
		"alert":   alert,
	})
}

// ============================================================================
// AUDIT LOG ROUTES (FR-005)
// ============================================================================

func GetAuditLogs(c *fiber.Ctx) error {
	var logs []AuditLog

	// Pagination
	page, _ := strconv.Atoi(c.Query("page", "1"))
	pageSize, _ := strconv.Atoi(c.Query("page_size", "50"))
	offset := (page - 1) * pageSize

	// Filters
	userID := c.Query("user_id", "")
	action := c.Query("action", "")
	entityType := c.Query("entity_type", "")

	query := DB
	if userID != "" {
		query = query.Where("user_id = ?", userID)
	}
	if action != "" {
		query = query.Where("action = ?", action)
	}
	if entityType != "" {
		query = query.Where("entity_type = ?", entityType)
	}

	var total int64
	query.Model(&AuditLog{}).Count(&total)

	if err := query.Order("timestamp DESC").Limit(pageSize).Offset(offset).Find(&logs).Error; err != nil {
		return c.Status(500).JSON(fiber.Map{
			"error": "Failed to retrieve audit logs",
			"code":  "DATABASE_ERROR",
		})
	}

	return c.JSON(fiber.Map{
		"logs":        logs,
		"page":        page,
		"page_size":   pageSize,
		"total":       total,
		"total_pages": (total + int64(pageSize) - 1) / int64(pageSize),
	})
}

// ============================================================================
// HEALTH CHECK
// ============================================================================

func HealthCheck(c *fiber.Ctx) error {
	// Check database connection
	sqlDB, err := DB.DB()
	if err != nil {
		return c.Status(503).JSON(fiber.Map{
			"status":  "unhealthy",
			"message": "Database connection error",
		})
	}

	if err := sqlDB.Ping(); err != nil {
		return c.Status(503).JSON(fiber.Map{
			"status":  "unhealthy",
			"message": "Database ping failed",
		})
	}

	return c.JSON(fiber.Map{
		"status":    "healthy",
		"message":   "Dunder Mifflin Inventory System is running",
		"timestamp": time.Now(),
	})
}

// ============================================================================
// MAIN
// ============================================================================

func main() {
	// Initialize database
	if err := InitDatabase(); err != nil {
		log.Fatal("Failed to connect to database:", err)
	}

	// Seed users
	if err := SeedUsers(); err != nil {
		log.Fatal("Failed to seed users:", err)
	}

	// Clean up expired sessions periodically
	go func() {
		ticker := time.NewTicker(1 * time.Hour)
		defer ticker.Stop()
		for range ticker.C {
			DB.Where("expires_at < ?", time.Now()).Delete(&Session{})
		}
	}()

	// Create Fiber app
	app := fiber.New(fiber.Config{
		AppName:      "Dunder Mifflin Inventory System v2.0",
		ErrorHandler: CustomErrorHandler,
	})

	// Middleware
	app.Use(logger.New())
	app.Use(cors.New(cors.Config{
		AllowOrigins:     "http://localhost:3000,http://localhost:8080",
		AllowCredentials: true,
	}))

	// Serve static files
	app.Static("/", "./public")

	// API Routes
	api := app.Group("/api/v1")

	// Health check (public)
	api.Get("/health", HealthCheck)

	// Authentication routes (public)
	api.Post("/auth/login", Login)

	// Protected routes
	protected := api.Group("", AuthMiddleware)
	protected.Post("/auth/logout", Logout)
	protected.Get("/auth/me", GetCurrentUser)

	// Product routes (role-based access)
	protected.Get("/products", GetInventory)
	protected.Get("/products/:id", GetProduct)
	protected.Post("/products", RoleMiddleware(RoleEmployee, RoleManager, RoleAdmin), AddProduct)
	protected.Put("/products/:id", RoleMiddleware(RoleEmployee, RoleManager, RoleAdmin), UpdateProduct)
	protected.Delete("/products/:id", RoleMiddleware(RoleManager, RoleAdmin), DeleteProduct)

	// Low stock alerts (managers and admins only)
	protected.Get("/alerts", RoleMiddleware(RoleManager, RoleAdmin), GetLowStockAlerts)
	protected.Post("/alerts/:id/acknowledge", RoleMiddleware(RoleManager, RoleAdmin), AcknowledgeAlert)

	// Audit logs (admins only)
	protected.Get("/audit-logs", RoleMiddleware(RoleAdmin), GetAuditLogs)

	// Start server
	log.Println("✓ Server starting on http://localhost:3000")
	log.Println("✓ Default users created - check console for credentials")
	log.Fatal(app.Listen(":3000"))
}

// Custom error handler
func CustomErrorHandler(c *fiber.Ctx, err error) error {
	code := fiber.StatusInternalServerError
	message := "Internal Server Error"

	if e, ok := err.(*fiber.Error); ok {
		code = e.Code
		message = e.Message
	}

	return c.Status(code).JSON(fiber.Map{
		"error": message,
		"code":  "SERVER_ERROR",
	})
}
